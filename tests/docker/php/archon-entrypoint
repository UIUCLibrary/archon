#!/bin/bash
# Entrypoint of the Archon test environment PHP container: tests/testenv/compose.yaml (fpm variant, host Apache)
# and docker-compose.yml / docker-compose-traefik.yml at the repository root (apache variant).
#
# "serve" (the default command):
#   1. archon-testenv prepare: secrets, one Archon site per database under /var/www/html/<site>
#   2. archon-testenv init: restores backups/<site>.bak or installs sample data, as needed
#      (the Archon web installer runs through PHP's built-in web server inside the container)
#   3. PHP-FPM (fpm image variant) or Apache (apache variant) becomes the main process
#
# Any other command (e.g. "podman compose run --rm php bash") runs without initialisation.
set -uo pipefail

if [ "$#" -gt 0 ] && [ "$1" != "serve" ]; then
    exec docker-php-entrypoint "$@"
fi

if command -v php-fpm >/dev/null 2>&1; then
    server=(php-fpm)
    stop_signals=(TERM INT QUIT)
else
    server=(apache2-foreground)
    stop_signals=(TERM INT WINCH)
fi

# Apache variant (docker-compose.yml, docker-compose-traefik.yml): writes /etc/apache2/archon-proxy.conf, which
# the virtual host in apache-archon.conf includes.
#   ARCHON_TRUSTED_PROXIES  addresses/CIDR blocks of the reverse proxy (Traefik). Requests from them may set
#                           the client address (X-Forwarded-For) and the scheme (X-Forwarded-Proto: https sets
#                           HTTPS=on, which Archon's isSecureConnection() reads). Empty: both headers are ignored.
configure_apache() {
    local conf=/etc/apache2/archon-proxy.conf proxies="${ARCHON_TRUSTED_PROXIES:-}" expr="" entry
    {
        echo "# Generated by archon-entrypoint from ARCHON_TRUSTED_PROXIES."
        if [ -n "${proxies}" ]; then
            for entry in ${proxies}; do
                if ! [[ "${entry}" =~ ^[0-9A-Fa-f.:]+(/[0-9]{1,3})?$ ]]; then
                    echo "[archon] ARCHON_TRUSTED_PROXIES: '${entry}' is not an IP address or CIDR block" >&2
                    return 1
                fi
                expr="${expr:+${expr} || }%{CONN_REMOTE_ADDR} -ipmatch '${entry}'"
            done
            echo "RemoteIPHeader X-Forwarded-For"
            echo "RemoteIPInternalProxy ${proxies}"
            echo "SetEnvIfExpr \"%{HTTP:X-Forwarded-Proto} == 'https' && (${expr})\" HTTPS=on"
        fi
    } > "${conf}.tmp" && mv "${conf}.tmp" "${conf}"
}

if [ "${server[0]}" = apache2-foreground ] && ! configure_apache; then
    exit 1
fi

mkdir -p /run/archon
rm -f /run/archon/ready

if ! archon-testenv prepare; then
    echo "[testenv] preparation failed; see the messages above" >&2
    exit 1
fi

# "podman compose stop" / "docker compose stop" during a long first initialisation stops the container promptly; an interrupted
# site has no completion marker, so it is rebuilt on the next start.
trap 'echo "[testenv] stopping during initialisation" >&2; exit 143' "${stop_signals[@]}"
archon-testenv init &
wait "$!"
init_status=$?
trap - "${stop_signals[@]}"

echo "${init_status}" > /run/archon/ready
exec docker-php-entrypoint "${server[@]}"
