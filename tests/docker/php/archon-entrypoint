#!/bin/bash
# Entrypoint of the Archon test environment PHP container (tests/testenv/compose.yaml).
#
# "serve" (the default command):
#   1. archon-testenv prepare: secrets, one Archon site per database under /var/www/html/<site>
#   2. archon-testenv init: restores backups/<site>.bak or installs sample data, as needed
#      (the Archon web installer runs through PHP's built-in web server inside the container)
#   3. PHP-FPM (fpm image variant) or Apache (apache variant) becomes the main process
#
# Any other command (e.g. "podman compose run --rm php bash") runs without initialisation.
set -uo pipefail

if [ "$#" -gt 0 ] && [ "$1" != "serve" ]; then
    exec docker-php-entrypoint "$@"
fi

if command -v php-fpm >/dev/null 2>&1; then
    server=(php-fpm)
    stop_signals=(TERM INT QUIT)
else
    server=(apache2-foreground)
    stop_signals=(TERM INT WINCH)
fi

mkdir -p /run/archon
rm -f /run/archon/ready

if ! archon-testenv prepare; then
    echo "[testenv] preparation failed; see the messages above" >&2
    exit 1
fi

# "podman compose stop" / "docker compose stop" during a long first initialisation stops the container promptly; an interrupted
# site has no completion marker, so it is rebuilt on the next start.
trap 'echo "[testenv] stopping during initialisation" >&2; exit 143' "${stop_signals[@]}"
archon-testenv init &
wait "$!"
init_status=$?
trap - "${stop_signals[@]}"

echo "${init_status}" > /run/archon/ready
exec docker-php-entrypoint "${server[@]}"
