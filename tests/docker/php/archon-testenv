function cmdProbe($Site, $Args)
{
   global $Config;
   $Report = "/var/log/archon/probe-$Site.json";
   $Log = "/var/log/archon/probe-$Site.log";
   $Command = 'php ' . escapeshellarg($Config['source_dir'] . '/tests/production-probe/archon-probe.php')
      . ' --archon-dir=' . escapeshellarg($Config['docroot'] . '/' . $Site);
