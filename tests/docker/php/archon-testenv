#!/usr/bin/env php
<?php
/**
 * Initialises and manages the Archon test environment (tests/testenv/compose.yaml).
 *
 *   archon-testenv status              each site's URL, database and data source
 *   archon-testenv credentials         the test administrator login and password
 *   archon-testenv reset SITE...|all   rebuild databases (restore the .bak again, or fresh sample data)
 *   archon-testenv crawl SITE [args]   request every public and admin page, report PHP diagnostics
 *                                      (through PHP's built-in server, or --base=URL for the host Apache)
 *   archon-testenv crud SITE [args]    create, read, update and delete records through the staff and public
 *                                      interfaces and check the database (tests/tools/crud.php; e.g.
 *                                      --only=collections, --keep). Records it creates are deleted again.
 *   archon-testenv diagnostics [args]  summarise the PHP warnings/errors recorded while testing
 *                                      (--json, --type=E_WARNING; --clear empties the record)
 *   archon-testenv probe SITE [args]   run the read-only production probe against a site database: schema,
 *                                      configuration, encoding counters per column (tests/production-probe)
 *   archon-testenv bundle              pack every report in /var/log/archon into one .tar.gz to send back
 *   archon-testenv sql SITE "query"    run a query against a site database (as sa)
 *
 * Used by the entrypoint (archon-entrypoint):
 *   archon-testenv prepare             secrets, per-site code and config.inc.php
 *   archon-testenv init                create, restore or keep each site database
 *
 * The Archon web installer and the crawler need HTTP, but the container only runs PHP-FPM (the host's
 * Apache httpd is the web server), so they use PHP's built-in web server on 127.0.0.1:8099 inside the
 * container while they run.
 *
 * Settings (environment): ARCHON_SITES, ARCHON_SAMPLE_SIZE, ARCHON_ADMIN_LOGIN, ARCHON_ADMIN_PASSWORD,
 * MSSQL_SA_PASSWORD, ARCHON_PUBLIC_URL, ARCHON_SHOW_ERRORS. See tests/testenv/README.md.
 */

const MARKER_NAME = 'ArchonTestEnv';
const SAMPLE_DATA_VERSION = 1;
const WEB_LOGIN = 'archon_web';
const LOCAL_SERVER = '127.0.0.1:8099';

$Config = array(
   'sites' => preg_split('/[\s,]+/', trim(getenv('ARCHON_SITES') ?: 'archives ihlc rbml ala'), -1, PREG_SPLIT_NO_EMPTY),
   'size' => getenv('ARCHON_SAMPLE_SIZE') ?: 'standard',
   'admin_login' => getenv('ARCHON_ADMIN_LOGIN') ?: 'testadmin',
   'db_prefix' => 'archon_',
   'mssql_host' => getenv('MSSQL_HOST') ?: 'mssql',
   'secrets_dir' => getenv('ARCHON_SECRETS_DIR') ?: '/run/archon-secrets',
   'backups_dir' => '/archon/backups',
   'staging_dir' => '/archon/staging',
   'source_dir' => rtrim(getenv('ARCHON_SOURCE_DIR') ?: '/opt/archon/src', '/'),
   'docroot' => '/var/www/html',
   'state_dir' => '/run/archon',
   'public_url' => rtrim(getenv('ARCHON_PUBLIC_URL') ?: 'http://localhost', '/'),
);

// Default theme and template set per production install (tests/research/live-survey/summary.md, section A).
$Profiles = array(
   'archives' => array('title' => 'University Archives (library_web, plus the sousa2 theme for repository 2)', 'theme' => 'library_web', 'templateset' => 'illinois',
      'extra_links' => array('sousa2 theme (repository 2)' => '?settheme=sousa2&setrepositoryid=2', 'all repositories' => '?settheme=library_web&setrepositoryid=0')),
   'ihlc' => array('title' => 'Illinois History and Lincoln Collections', 'theme' => 'ihlc', 'templateset' => 'ihlc', 'extra_links' => array()),
   'rbml' => array('title' => 'Rare Book & Manuscript Library', 'theme' => 'rbml', 'templateset' => 'rbml', 'extra_links' => array()),
   'ala' => array('title' => 'American Library Association Archives', 'theme' => 'ala_redo', 'templateset' => 'ala', 'extra_links' => array()),
);

const LOG_DIR = '/var/log/archon';

function out($Message)
{
   echo '[testenv] ' . $Message . "\n";
   @ob_flush();
   flush();
   logLine($Message);
}

function warn($Message)
{
   fwrite(STDERR, '[testenv] WARNING: ' . $Message . "\n");
   logLine('WARNING: ' . $Message);
}

/** Keeps a timestamped copy of everything init, reset and the other commands report (included in "bundle"). */
function logLine($Message)
{
   @file_put_contents(LOG_DIR . '/testenv.log', date('Y-m-d H:i:s ') . $Message . "\n", FILE_APPEND | LOCK_EX);
}

/**
 * PHP-FPM's workers run as www-data and append to these files, but archon-testenv, the installer and the
 * crawler run as root: a file root creates first would be read-only for PHP-FPM, and every error of a
 * request through the host's Apache would be lost. Runs when the container starts and after every command.
 */
function ensureLogFiles()
{
   if(!is_dir(LOG_DIR))
   {
      return;
   }
   @chown(LOG_DIR, 'www-data');
   foreach(array('diagnostics.jsonl', 'php_errors.log') as $Name)
   {
      $File = LOG_DIR . '/' . $Name;
      if(!file_exists($File))
      {
         @touch($File);
      }
      @chown($File, 'www-data');
      @chgrp($File, 'www-data');
      @chmod($File, 0666);
   }
}

/** The compose command shown to the user: ARCHON_COMPOSE_COMMAND, else "podman compose" or "docker compose" (Podman creates /run/.containerenv). */
function compose()
{
   $Command = trim((string)getenv('ARCHON_COMPOSE_COMMAND'));
   if($Command !== '')
   {
      return $Command;
   }
   return file_exists('/run/.containerenv') ? 'podman compose' : 'docker compose';
}

/** True in the apache image variant (Apache httpd in the container, docker-compose*.yml at the repository root). */
function apacheVariant()
{
   return is_dir('/etc/apache2');
}

/** Address of the index of sites. */
function indexUrl()
{
   global $Config;
   return $Config['public_url'] . (apacheVariant() ? '/' : '/archon-testenv/');
}

function profileFor($Site)
{
   global $Profiles;
   return isset($Profiles[$Site]) ? $Site : 'archives';
}

function databaseFor($Site)
{
   global $Config;
   return $Config['db_prefix'] . $Site;
}

function checkSites()
{
   global $Config;
   foreach($Config['sites'] as $Site)
   {
      if(!preg_match('/^[a-z][a-z0-9_]{0,39}$/', $Site))
      {
         fwrite(STDERR, "[testenv] invalid site name '$Site' in ARCHON_SITES (use lower-case letters, digits and _)\n");
         exit(64);
      }
   }
}

/* ---------------------------------------------------------------- secrets */

function generateSecret($Groups = 4)
{
   // Unambiguous characters; the fixed prefix satisfies SQL Server's password complexity rules.
   $Alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';
   $Parts = array();
   for($g = 0; $g < $Groups; $g++)
   {
      $Part = '';
      for($i = 0; $i < 5; $i++)
      {
         $Part .= $Alphabet[random_int(0, strlen($Alphabet) - 1)];
      }
      $Parts[] = $Part;
   }
   return 'Tq7-' . implode('-', $Parts);
}

function secretPath($Name)
{
   global $Config;
   return $Config['secrets_dir'] . '/' . $Name;
}

function readSecret($Name)
{
   $File = secretPath($Name);
   if(!is_readable($File))
   {
      fwrite(STDERR, "[testenv] secret $File is missing; is this the php container of tests/testenv?\n");
      exit(1);
   }
   return trim(file_get_contents($File));
}

function writeSecret($Name, $Value, $Mode)
{
   $File = secretPath($Name);
   $Temp = $File . '.tmp';
   file_put_contents($Temp, $Value . "\n");
   chmod($Temp, $Mode);
   rename($Temp, $File);
}

function ensureSecrets()
{
   global $Config;
   if(!is_dir($Config['secrets_dir']))
   {
      mkdir($Config['secrets_dir'], 0755, true);
   }

   // SQL Server only reads its SA password when the data volume is created, so the stored value wins.
   $Sa = getenv('MSSQL_SA_PASSWORD');
   if(!file_exists(secretPath('mssql-sa')))
   {
      writeSecret('mssql-sa', $Sa !== false && $Sa !== '' ? $Sa : generateSecret(), 0644);
      out('created the SQL Server SA password (' . ($Sa ? 'from MSSQL_SA_PASSWORD' : 'generated') . ')');
   }
   elseif($Sa && $Sa !== readSecret('mssql-sa'))
   {
      warn('MSSQL_SA_PASSWORD differs from the password SQL Server was created with; using the stored one. Run "' . compose() . ' down -v" to start over.');
   }

   if(!file_exists(secretPath('archon-web')))
   {
      writeSecret('archon-web', generateSecret(), 0600);
   }

   $Admin = getenv('ARCHON_ADMIN_PASSWORD');
   if($Admin !== false && $Admin !== '')
   {
      if(!file_exists(secretPath('archon-admin')) || readSecret('archon-admin') !== $Admin)
      {
         writeSecret('archon-admin', $Admin, 0600);
      }
   }
   elseif(!file_exists(secretPath('archon-admin')))
   {
      writeSecret('archon-admin', generateSecret(3), 0600);
      out('generated the test administrator password (' . compose() . ' exec php archon-testenv credentials)');
   }
}

/* ---------------------------------------------------------------- SQL Server */

function sqlConnect($Database = 'master', $Quiet = false)
{
   global $Config;
   $Connection = sqlsrv_connect($Config['mssql_host'], array(
      'UID' => 'sa', 'PWD' => readSecret('mssql-sa'), 'Database' => $Database,
      'TrustServerCertificate' => true, 'CharacterSet' => 'UTF-8', 'LoginTimeout' => 10,
   ));
   if($Connection === false && !$Quiet)
   {
      throw new RuntimeException("cannot connect to SQL Server ($Database): " . sqlErrors());
   }
   return $Connection;
}

function sqlErrors()
{
   $Messages = array();
   foreach((array)sqlsrv_errors(SQLSRV_ERR_ERRORS) as $Error)
   {
      $Messages[] = $Error['message'];
   }
   return implode(' | ', $Messages);
}

/**
 * Runs a statement (or batch) to completion and returns the rows of every result set.
 */
function sqlRun($Connection, $Sql, $Params = array())
{
   $Statement = sqlsrv_query($Connection, $Sql, $Params, array('QueryTimeout' => 0));
   if($Statement === false)
   {
      throw new RuntimeException(sqlErrors() . "\n  in: " . substr(preg_replace('/\s+/', ' ', $Sql), 0, 300));
   }
   $Rows = array();
   do
   {
      if(sqlsrv_num_fields($Statement) > 0)
      {
         while(($Row = sqlsrv_fetch_array($Statement, SQLSRV_FETCH_ASSOC)) !== NULL && $Row !== false)
         {
            $Rows[] = $Row;
         }
      }
      $Next = sqlsrv_next_result($Statement);
   }
   while($Next === true);
   if($Next === false)
   {
      throw new RuntimeException(sqlErrors() . "\n  in: " . substr(preg_replace('/\s+/', ' ', $Sql), 0, 300));
   }
   sqlsrv_free_stmt($Statement);
   return $Rows;
}

function sqlValue($Connection, $Sql, $Params = array())
{
   $Rows = sqlRun($Connection, $Sql, $Params);
   return $Rows ? reset($Rows[0]) : NULL;
}

function quoteName($Name)
{
   return '[' . str_replace(']', ']]', $Name) . ']';
}

function quoteString($Value)
{
   return "N'" . str_replace("'", "''", $Value) . "'";
}

function waitForSqlServer()
{
   global $Config;
   $Start = time();
   $Deadline = $Start + (int)(getenv('ARCHON_SQL_WAIT') ?: 900);
   $NextReport = $Start + 30;
   $Last = '';
   out("waiting for SQL Server at {$Config['mssql_host']}");
   while(time() < $Deadline)
   {
      $Connection = @sqlConnect('master', true);
      if($Connection)
      {
         $Version = sqlValue($Connection, "SELECT CAST(SERVERPROPERTY('ProductVersion') AS nvarchar(50)) + ' ' + CAST(SERVERPROPERTY('Edition') AS nvarchar(100))");
         out("SQL Server is up ($Version)");
         return $Connection;
      }
      $Last = sqlErrors();
      $Problem = sqlHostProblem($Config['mssql_host']);
      if($Problem !== '')
      {
         $Last = "$Problem; last error: $Last";
      }
      if(time() >= $NextReport)
      {
         out('still waiting for SQL Server (' . (time() - $Start) . " s): $Last");
         $NextReport = time() + 30;
      }
      sleep(3);
   }
   throw new RuntimeException('SQL Server did not become available: ' . $Last);
}

/**
 * Returns a message when the SQL Server host name does not resolve inside the container (container DNS
 * is missing or broken), or '' when it resolves or is an IP address. sqlsrv accepts "tcp:host,port" and
 * "host\instance".
 */
function sqlHostProblem($Host)
{
   $Name = preg_split('/[,\\\\]/', preg_replace('/^tcp:/i', '', trim($Host)))[0];
   if($Name === '' || filter_var(trim($Name, '[]'), FILTER_VALIDATE_IP) !== false || gethostbynamel($Name) !== false)
   {
      return '';
   }
   return "cannot resolve '$Name' inside the php container (container DNS; see Troubleshooting in tests/testenv/README.md)";
}

function sqlConfigure()
{
   sqlsrv_configure('WarningsReturnAsErrors', 0);
   sqlsrv_configure('LogSeverity', SQLSRV_LOG_SEVERITY_ERROR);
}

function ensureWebLogin($Master)
{
   $Secret = quoteString(readSecret('archon-web'));
   $Login = quoteName(WEB_LOGIN);
   sqlRun($Master, "IF SUSER_ID(N'" . WEB_LOGIN . "') IS NULL CREATE LOGIN $Login WITH PASSWORD = $Secret, CHECK_POLICY = OFF, DEFAULT_DATABASE = [master]; ELSE ALTER LOGIN $Login WITH PASSWORD = $Secret;");
}

function databaseState($Master, $Database)
{
   return sqlValue($Master, 'SELECT state_desc FROM sys.databases WHERE name = ?', array($Database));
}

function readMarker($Master, $Database)
{
   if(databaseState($Master, $Database) !== 'ONLINE')
   {
      return NULL;
   }
   $Value = sqlValue($Master, 'SELECT CAST(value AS nvarchar(4000)) FROM ' . quoteName($Database) . ".sys.extended_properties WHERE class = 0 AND name = N'" . MARKER_NAME . "'");
   return $Value === NULL ? NULL : (string)$Value;
}

function writeMarker($Database, $Value)
{
   $Connection = sqlConnect($Database);
   sqlRun($Connection, "IF EXISTS (SELECT 1 FROM sys.extended_properties WHERE class = 0 AND name = N'" . MARKER_NAME . "') EXEC sys.sp_dropextendedproperty @name = N'" . MARKER_NAME . "';");
   sqlRun($Connection, "EXEC sys.sp_addextendedproperty @name = N'" . MARKER_NAME . "', @value = ?;", array($Value));
   sqlsrv_close($Connection);
}

function dropDatabase($Master, $Database)
{
   $State = databaseState($Master, $Database);
   if($State === NULL)
   {
      return;
   }
   $Quoted = quoteName($Database);
   if($State === 'ONLINE')
   {
      sqlRun($Master, "ALTER DATABASE $Quoted SET SINGLE_USER WITH ROLLBACK IMMEDIATE;");
   }
   sqlRun($Master, "DROP DATABASE $Quoted;");
   out("dropped database $Database");
}

/* ---------------------------------------------------------------- sites */

function syncSite($Site)
{
   global $Config;
   $Env = 'ARCHON_TEST_MSSQL_HOST=' . escapeshellarg($Config['mssql_host'])
      . ' ARCHON_TEST_MSSQL_USER=' . escapeshellarg(WEB_LOGIN)
      . ' ARCHON_TEST_MSSQL_SECRET=' . escapeshellarg(readSecret('archon-web'));
   $Command = "env $Env archon-sync " . escapeshellarg($Site) . ' MSSQL ' . escapeshellarg(databaseFor($Site)) . ' ' . escapeshellarg($Config['source_dir']);
   passthru($Command . ' > /dev/null', $Status);
   if($Status)
   {
      throw new RuntimeException("archon-sync failed for $Site");
   }
}

function backupFor($Site)
{
   global $Config;
   $File = $Config['backups_dir'] . '/' . $Site . '.bak';
   return is_file($File) ? $File : NULL;
}

function backupSignature($File)
{
   clearstatcache(true, $File);
   return 'bak:' . basename($File) . ':' . filesize($File) . ':' . filemtime($File);
}

function sampleSignature()
{
   global $Config;
   return 'sample:' . $Config['size'] . ':v' . SAMPLE_DATA_VERSION;
}

function humanSize($Bytes)
{
   $Units = array('B', 'KB', 'MB', 'GB', 'TB');
   $i = 0;
   while($Bytes >= 1024 && $i < count($Units) - 1)
   {
      $Bytes /= 1024;
      $i++;
   }
   return round($Bytes, 1) . ' ' . $Units[$i];
}

function describeMarker($Marker)
{
   if($Marker === NULL)
   {
      return 'not initialised';
   }
   $Parts = explode(':', $Marker);
   if($Parts[0] == 'bak' && count($Parts) >= 4)
   {
      return 'restored from backups/' . $Parts[1] . ' (' . humanSize((float)$Parts[2]) . ', modified ' . date('Y-m-d H:i', (int)$Parts[3]) . ')';
   }
   if($Parts[0] == 'sample' && count($Parts) >= 3)
   {
      return 'synthetic sample data (' . $Parts[1] . ', generator ' . $Parts[2] . ')';
   }
   return $Marker;
}

/**
 * Brings a site database to the desired state. Returns a description of its data source.
 */
function ensureSite($Master, $Site, $Force)
{
   global $Config;
   $Database = databaseFor($Site);
   $Backup = backupFor($Site);
   $Desired = $Backup ? backupSignature($Backup) : sampleSignature();
   $Current = readMarker($Master, $Database);

   $Rebuild = $Force;
   if($Force)
   {
      out("$Site: rebuilding $Database on request");
   }
   elseif($Current === NULL)
   {
      $Rebuild = true;
      out("$Site: $Database " . (databaseState($Master, $Database) === NULL ? 'does not exist yet' : 'was not fully initialised') . '; building it');
   }
   elseif($Backup && $Current !== $Desired)
   {
      $Rebuild = true;
      out("$Site: backups/" . basename($Backup) . " is new or changed; restoring it");
   }
   elseif(!$Backup && strpos($Current, 'bak:') === 0)
   {
      out("$Site: keeping the database restored earlier (" . describeMarker($Current) . '); the backup file is gone. Run "archon-testenv reset ' . $Site . '" to switch to sample data.');
   }
   elseif(!$Backup && $Current !== $Desired)
   {
      out("$Site: keeping existing sample data (" . describeMarker($Current) . '); run "archon-testenv reset ' . $Site . '" to regenerate it as ' . describeMarker($Desired) . '.');
   }

   if($Rebuild)
   {
      dropDatabase($Master, $Database);
      $Started = microtime(true);
      if($Backup)
      {
         restoreBackup($Master, $Site, $Database, $Backup);
      }
      else
      {
         installSampleData($Site, $Database);
      }
      writeMarker($Database, $Desired);
      $Current = $Desired;
      out(sprintf('%s: %s ready in %.0f s', $Site, $Database, microtime(true) - $Started));
   }

   ensureDatabaseAccess($Database);
   ensureAdministrator($Site, $Database);
   $Description = describeMarker($Current);
   if(strpos($Current, 'bak:') === 0)
   {
      $Problem = reportDatabaseChecks($Site, $Database);
      if($Problem !== NULL)
      {
         $Description .= '; PROBLEM: ' . $Problem;
      }
   }
   return $Description;
}

/**
 * Starts PHP's built-in web server on LOCAL_SERVER (document root /var/www/html) for the installer and
 * the crawler, once per run; it is stopped when archon-testenv exits.
 */
function startLocalServer()
{
   global $Config;
   static $Process = NULL;
   if($Process)
   {
      return 'http://' . LOCAL_SERVER;
   }

   $Log = '/var/log/archon/builtin-server.log';
   $Environment = getenv();
   $Environment['PHP_CLI_SERVER_WORKERS'] = '4';
   // setsid: the server and its workers form one process group, which is stopped as a whole.
   $Process = proc_open(array('setsid', 'php', '-S', LOCAL_SERVER, '-t', $Config['docroot']),
      array(0 => array('file', '/dev/null', 'r'), 1 => array('file', $Log, 'a'), 2 => array('file', $Log, 'a')), $Pipes, $Config['docroot'], $Environment);
   if(!is_resource($Process))
   {
      throw new RuntimeException('cannot start PHP\'s built-in web server');
   }
   $Pid = proc_get_status($Process)['pid'];
   register_shutdown_function(function() use (&$Process, $Pid) {
      if(is_resource($Process))
      {
         posix_kill(-$Pid, 15); // SIGTERM; the constant comes from pcntl, which the image does not load
         proc_close($Process);
         $Process = NULL;
      }
   });

   list($Host, $Port) = explode(':', LOCAL_SERVER);
   for($i = 0; $i < 100; $i++)
   {
      $Socket = @fsockopen($Host, (int)$Port, $Errno, $Error, 1);
      if($Socket)
      {
         fclose($Socket);
         return 'http://' . LOCAL_SERVER;
      }
      if(!proc_get_status($Process)['running'])
      {
         break;
      }
      usleep(100000);
   }
   throw new RuntimeException("PHP's built-in web server did not start on " . LOCAL_SERVER . " (see $Log)");
}

function runTool($Label, $Command, $Env)
{
   $Prefix = '';
   foreach($Env as $Name => $Value)
   {
      $Prefix .= $Name . '=' . escapeshellarg($Value) . ' ';
   }
   $Process = proc_open('env ' . $Prefix . $Command . ' 2>&1', array(1 => array('pipe', 'w')), $Pipes);
   while(($Line = fgets($Pipes[1])) !== false)
   {
      echo "[testenv] $Label: " . rtrim($Line) . "\n";
   }
   fclose($Pipes[1]);
   return proc_close($Process);
}

function toolEnv()
{
   global $Config;
   return array(
      'ARCHON_TEST_MSSQL_HOST' => $Config['mssql_host'],
      'ARCHON_TEST_MSSQL_USER' => 'sa',
      'ARCHON_TEST_MSSQL_SECRET' => readSecret('mssql-sa'),
      'ARCHON_TEST_ADMIN_LOGIN' => $Config['admin_login'],
      'ARCHON_TEST_ADMIN_SECRET' => readSecret('archon-admin'),
   );
}

function installSampleData($Site, $Database)
{
   global $Config, $Profiles;
   $Source = $Config['source_dir'];
   $Profile = profileFor($Site);

   out("$Site: running the Archon web installer");
   $Base = startLocalServer();
   $Status = runTool($Site, 'php ' . escapeshellarg("$Source/tests/tools/install-database.php")
      . ' --site=' . escapeshellarg($Config['docroot'] . '/' . $Site)
      . ' --database=' . escapeshellarg($Database)
      . ' --base=' . escapeshellarg("$Base/$Site/")
      . ' --app-login=' . escapeshellarg(WEB_LOGIN)
      . ' --no-fixtures', toolEnv());
   if($Status)
   {
      throw new RuntimeException("the Archon installer failed for $Site (exit $Status)");
   }

   out("$Site: generating sample data (profile $Profile, size {$Config['size']})");
   $Status = runTool($Site, 'php -d memory_limit=1G ' . escapeshellarg("$Source/tests/sample-data/generate.php")
      . ' --database=' . escapeshellarg($Database)
      . ' --profile=' . escapeshellarg($Profile)
      . ' --size=' . escapeshellarg($Config['size']), toolEnv());
   if($Status)
   {
      throw new RuntimeException("sample data generation failed for $Site (exit $Status)");
   }

   $Connection = sqlConnect($Database);
   $Settings = array(
      'Default Theme' => $Profiles[$Profile]['theme'],
      'Default Template Set' => $Profiles[$Profile]['templateset'],
      // archon.org no longer answers update checks.
      'Check For Updates' => '0',
   );
   foreach($Settings as $Directive => $Value)
   {
      sqlRun($Connection, 'UPDATE tblCore_Configuration SET Value = ? WHERE PackageID = 1 AND Directive = ?', array($Value, $Directive));
   }
   sqlsrv_close($Connection);
}

function restoreBackup($Master, $Site, $Database, $Backup)
{
   global $Config;
   $Size = filesize($Backup);
   out("$Site: restoring backups/" . basename($Backup) . ' (' . humanSize($Size) . ')');

   // SQL Server (uid 10001) reads the file through the shared bind mount when it is world-readable;
   // otherwise a readable copy is staged in a volume first.
   $Path = $Backup;
   $Staged = NULL;
   if(!(fileperms($Backup) & 0004))
   {
      $Free = @disk_free_space($Config['staging_dir']);
      if($Free !== false && $Free < $Size * 1.1)
      {
         throw new RuntimeException('backups/' . basename($Backup) . ' is not world-readable and there is not enough space to stage a copy; run: chmod 644 tests/testenv/backups/' . basename($Backup));
      }
      out("$Site: the backup is not world-readable; staging a readable copy");
      $Staged = $Config['staging_dir'] . '/' . basename($Backup);
      if(!copy($Backup, $Staged))
      {
         throw new RuntimeException("cannot copy the backup to $Staged");
      }
      chmod($Staged, 0644);
      $Path = $Staged;
   }

   try
   {
      $Disk = 'FROM DISK = ' . quoteString($Path);
      $Headers = sqlRun($Master, "RESTORE HEADERONLY $Disk");
      $Position = NULL;
      $Chosen = NULL;
      foreach($Headers as $Header)
      {
         if((int)$Header['BackupType'] === 1)
         {
            $Position = (int)$Header['Position'];
            $Chosen = $Header;
         }
      }
      if($Position === NULL)
      {
         throw new RuntimeException('the file contains no full database backup (differential and log backups are not supported)');
      }
      $Finish = $Chosen['BackupFinishDate'] instanceof DateTimeInterface ? $Chosen['BackupFinishDate']->format('Y-m-d H:i') : '?';
      out(sprintf('%s: backup set %d of %d: database %s, taken %s, SQL Server %s.%s', $Site, $Position, count($Headers),
         $Chosen['DatabaseName'], $Finish, $Chosen['SoftwareVersionMajor'], $Chosen['SoftwareVersionMinor']));

      $Files = sqlRun($Master, "RESTORE FILELISTONLY $Disk WITH FILE = $Position");
      $Moves = array();
      $DataFiles = 0;
      foreach($Files as $File)
      {
         $Logical = $File['LogicalName'];
         $Safe = preg_replace('/[^A-Za-z0-9_]+/', '_', $Logical);
         switch($File['Type'])
         {
            case 'L':
               $Target = "/var/opt/mssql/data/{$Database}_{$Safe}.ldf";
               break;
            case 'D':
               $Target = "/var/opt/mssql/data/{$Database}_{$Safe}" . ($DataFiles++ ? '.ndf' : '.mdf');
               break;
            default:
               $Target = "/var/opt/mssql/data/{$Database}_{$Safe}";
         }
         $Moves[] = 'MOVE ' . quoteString($Logical) . ' TO ' . quoteString($Target);
      }

      sqlRun($Master, 'RESTORE DATABASE ' . quoteName($Database) . " $Disk WITH FILE = $Position, " . implode(', ', $Moves) . ', REPLACE, RECOVERY, STATS = 25');
   }
   finally
   {
      if($Staged)
      {
         @unlink($Staged);
      }
   }

   $Quoted = quoteName($Database);
   sqlRun($Master, "ALTER AUTHORIZATION ON DATABASE::$Quoted TO [sa];");
   sqlRun($Master, "ALTER DATABASE $Quoted SET MULTI_USER;");

   $Connection = sqlConnect($Database);
   $Info = sqlRun($Connection, "SELECT CAST(DATABASEPROPERTYEX(DB_NAME(), 'Collation') AS nvarchar(128)) AS Collation, (SELECT compatibility_level FROM sys.databases WHERE name = DB_NAME()) AS Compatibility, OBJECT_ID('tblCore_Packages') AS Packages");
   $Info = $Info[0];
   if(!$Info['Packages'])
   {
      warn("$Site: the restored database has no tblCore_Packages table; is this an Archon database?");
   }
   else
   {
      $Packages = array();
      foreach(sqlRun($Connection, 'SELECT APRCode, DBVersion, Enabled FROM tblCore_Packages ORDER BY ID') as $Row)
      {
         $Packages[] = $Row['APRCode'] . ' ' . $Row['DBVersion'] . ($Row['Enabled'] ? '' : ' (disabled)');
      }
      out("$Site: packages: " . implode(', ', $Packages));
   }
   out("$Site: collation {$Info['Collation']}, compatibility level {$Info['Compatibility']}");
   sqlsrv_close($Connection);
}

