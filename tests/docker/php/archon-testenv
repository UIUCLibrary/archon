function cmdBundle()
{
   global $Config;
   $Dir = '/var/log/archon';
   $Summary = "$Dir/diagnostics-summary";
   $Report = $Config['source_dir'] . '/tests/tools/diagnostics-report.php';
   exec('php ' . escapeshellarg($Report) . " $Dir/diagnostics.jsonl > $Summary.txt 2>&1");
   exec('php ' . escapeshellarg($Report) . " $Dir/diagnostics.jsonl --json > $Summary.json 2>&1");
   ob_start();
   cmdStatus();
   file_put_contents("$Dir/status.txt", ob_get_clean());
   if(file_exists("$Dir/php_errors.log"))
   {
      exec("tail -n 5000 $Dir/php_errors.log > $Dir/php_errors-tail.log");
   }

   $Files = array();
   foreach(array('status.txt', 'testenv.log', 'diagnostics-summary.txt', 'diagnostics-summary.json', 'php_errors-tail.log', 'crawl-*.json', 'crud-*.json', 'probe-*.json', 'probe-*.log') as $Pattern)
   {
      foreach(glob("$Dir/$Pattern") as $File)
      {
         $Files[] = basename($File);
      }
   }
   $Bundle = "$Dir/archon-reports-" . date('Ymd-His') . '.tar.gz';
   exec('tar -czf ' . escapeshellarg($Bundle) . ' -C ' . escapeshellarg($Dir) . ' ' . implode(' ', array_map('escapeshellarg', $Files)), $Output, $Status);
   if($Status)
   {
      fwrite(STDERR, "tar failed with status $Status\n");
      return $Status;
   }
   out('bundle: ' . $Bundle . ' (' . implode(', ', $Files) . ')');
   $Engine = file_exists('/run/.containerenv') ? 'podman' : 'docker';
   out("copy it out with: $Engine cp " . gethostname() . ":$Bundle .  (with sudo if the containers run as root)");
   return 0;
}

function requireSites($Args)
{
   global $Config;
   if(!$Args)
   {
      fwrite(STDERR, "name one or more sites (" . implode(', ', $Config['sites']) . ") or 'all'\n");
      exit(64);
   }
   if($Args == array('all'))
   {
      return $Config['sites'];
   }
   foreach($Args as $Site)
   {
      if(!in_array($Site, $Config['sites'], true))
      {
         fwrite(STDERR, "unknown site '$Site' (ARCHON_SITES: " . implode(', ', $Config['sites']) . ")\n");
         exit(64);
      }
   }
   return $Args;
}

checkSites();
register_shutdown_function('ensureLogFiles');
$Command = isset($argv[1]) ? $argv[1] : 'help';
$Args = array_slice($argv, 2);

try
{
   switch($Command)
   {
      case 'prepare':
         cmdPrepare();
         exit(0);
      case 'init':
         exit(cmdInit($Config['sites'], false));
      case 'reset':
         exit(cmdInit(requireSites($Args), true));
      case 'status':
         exit(cmdStatus());
      case 'credentials':
         exit(cmdCredentials());
      case 'crawl':
         $Sites = requireSites(array_slice($Args, 0, 1));
         exit(cmdCrawl($Sites[0], array_slice($Args, 1)));
      case 'crud':
         $Sites = requireSites(array_slice($Args, 0, 1));
         exit(cmdCrud($Sites[0], array_slice($Args, 1)));
      case 'diagnostics':
         exit(cmdDiagnostics($Args));
      case 'probe':
         $Sites = requireSites(array_slice($Args, 0, 1));
         exit(cmdProbe($Sites[0], array_slice($Args, 1)));
      case 'bundle':
         exit(cmdBundle());
      case 'sql':
         $Sites = requireSites(array_slice($Args, 0, 1));
         if(!isset($Args[1]))
         {
            fwrite(STDERR, "usage: archon-testenv sql SITE \"query\"\n");
            exit(64);
         }
         sqlConfigure();
         $Rows = sqlRun(sqlConnect(databaseFor($Sites[0])), $Args[1]);
         foreach($Rows as $Row)
         {
            foreach($Row as $Key => $Value)
            {
               if($Value instanceof DateTimeInterface)
               {
                  $Row[$Key] = $Value->format('c');
               }
            }
            echo json_encode($Row, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE) . "\n";
         }
         exit(0);
      default:
         $Help = file_get_contents(__FILE__);
         preg_match('#/\*\*(.*?)\*/#s', $Help, $Match);
         echo preg_replace('/^\s*\* ?/m', '', $Match[1]) . "\n";
         exit($Command == 'help' || $Command == '--help' ? 0 : 64);
   }
}
catch(Throwable $e)
{
   fwrite(STDERR, '[testenv] ERROR: ' . $e->getMessage() . "\n");
   exit(1);
}
