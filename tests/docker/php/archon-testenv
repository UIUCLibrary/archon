function banner($Statuses, $Failures)
{
   global $Config, $Profiles;
   $Lines = array(str_repeat('=', 78), ' Archon test environment (PHP ' . PHP_VERSION . ')' . ($Failures ? ' -- ' . count($Failures) . ' site(s) FAILED' : ' is ready'));
   foreach($Config['sites'] as $Site)
   {
      $Lines[] = sprintf('   %-9s %s/%s/', $Site, $Config['public_url'], $Site);
      foreach($Profiles[profileFor($Site)]['extra_links'] as $Label => $Query)
      {
         $Lines[] = sprintf('   %-9s %s/%s/%s', '', $Config['public_url'], $Site, $Query);
      }
      $Lines[] = sprintf('   %-9s %s', '', isset($Failures[$Site]) ? 'FAILED: ' . $Failures[$Site] : $Statuses[$Site]);
   }
   $Lines[] = ' Staff interface: <site>/?p=admin   login: ' . $Config['admin_login'];
   $Lines[] = ' Password: ' . compose() . ' exec php archon-testenv credentials';
   $Lines[] = ' Index of sites: ' . indexUrl() . (apacheVariant() ? '' : '   (host Apache: tests/testenv/httpd/archon-testenv.conf)');
   $Lines[] = str_repeat('=', 78);
   echo implode("\n", $Lines) . "\n";
}

