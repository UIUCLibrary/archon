function cmdPrepare()
{
   global $Config;
   ensureSecrets();
   if(!is_dir($Config['state_dir']))
   {
      mkdir($Config['state_dir'], 0755, true);
   }
   ensureLogFiles();
   // Read by error-capture.php (auto_prepend_file): show the fatal error that ended a request on the page.
   $Flag = $Config['state_dir'] . '/show-errors';
   if(filter_var(getenv('ARCHON_SHOW_ERRORS'), FILTER_VALIDATE_BOOLEAN))
   {
      touch($Flag);
   }
   elseif(file_exists($Flag))
   {
      unlink($Flag);
   }
   foreach($Config['sites'] as $Site)
   {
      syncSite($Site);
   }
   writeIndexPage(array());
   out('sites: ' . implode(', ', $Config['sites']) . ' (source ' . $Config['source_dir'] . ')'
      . (file_exists($Flag) ? '; fatal PHP errors are shown on the page (ARCHON_SHOW_ERRORS=1)' : ''));
}

function cmdInit($Sites, $Force)
{
   sqlConfigure();
   $Master = waitForSqlServer();
   ensureWebLogin($Master);

   $Statuses = array();
   $Failures = array();
   foreach($Sites as $Site)
   {
      try
      {
         $Statuses[$Site] = ensureSite($Master, $Site, $Force);
      }
      catch(Throwable $e)
      {
         $Failures[$Site] = $e->getMessage();
         $Statuses[$Site] = 'FAILED: ' . $e->getMessage();
         warn("$Site: " . $e->getMessage());
      }
   }

   global $Config;
   foreach($Config['sites'] as $Site)
   {
      if(!isset($Statuses[$Site]))
      {
         $Statuses[$Site] = describeMarker(readMarker($Master, databaseFor($Site)));
      }
   }
   writeIndexPage($Statuses);
   banner($Statuses, $Failures);
   return $Failures ? 1 : 0;
}

function cmdStatus()
{
   global $Config, $Profiles;
   sqlConfigure();
   $Master = sqlConnect();
   foreach($Config['sites'] as $Site)
   {
      $Database = databaseFor($Site);
      $Marker = readMarker($Master, $Database);
      echo "$Site\n";
      echo "  URL:       {$Config['public_url']}/$Site/   (staff: {$Config['public_url']}/$Site/?p=admin)\n";
      echo "  database:  $Database, " . describeMarker($Marker) . "\n";
      $Backup = backupFor($Site);
      if($Backup && ($Marker === NULL || $Marker !== backupSignature($Backup)))
      {
         echo "  pending:   backups/" . basename($Backup) . " will be restored on the next start (or: archon-testenv reset $Site)\n";
      }
      $Info = $Marker !== NULL ? siteCounts($Database) : NULL;
      if($Info)
      {
         $Counts = array();
         foreach($Info['counts'] as $Label => $Count)
         {
            $Counts[] = "$Count $Label";
         }
         echo '  records:   ' . implode(', ', $Counts) . "\n";
         if($Info['settings'])
         {
            echo '  defaults:  theme ' . ($Info['settings']['Default Theme'] ?? '?') . ', template set ' . ($Info['settings']['Default Template Set'] ?? '?') . "\n";
         }
         try
         {
            $Connection = sqlConnect($Database);
            $Notes = databaseChecks($Connection);
            sqlsrv_close($Connection);
            if(!array_filter($Notes, function($Note) { return $Note[0] != 'note'; }))
            {
               echo "  checks:    OK (tables in dbo; package versions and dependencies match the code)\n";
            }
            foreach($Notes as $Note)
            {
               echo '  ' . str_pad($Note[0] . ':', 10) . ' ' . $Note[1] . "\n";
            }
         }
         catch(RuntimeException $e)
         {
            echo '  checks:    could not run: ' . $e->getMessage() . "\n";
         }
      }
   }
   return 0;
}

