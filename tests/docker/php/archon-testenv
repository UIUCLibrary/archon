function cmdCrawl($Site, $Args)
{
   global $Config;
   $Report = "/var/log/archon/crawl-$Site.json";
   $Command = 'php ' . escapeshellarg($Config['source_dir'] . '/tests/tools/crawl.php')
      . ' --site=' . escapeshellarg($Config['docroot'] . '/' . $Site)
      . ' --report=' . escapeshellarg($Report);
   if(!preg_grep('/^--base=/', $Args))
   {
      $Command .= ' --base=' . escapeshellarg(startLocalServer() . "/$Site/");
   }
   foreach($Args as $Arg)
   {
      $Command .= ' ' . escapeshellarg($Arg);
   }
   $Status = runTool("crawl $Site", $Command, toolEnv() + array('ARCHON_TEST_DATABASE' => databaseFor($Site)));
   out("report: $Report (copy it out with: " . compose() . " exec php cat $Report > " . basename($Report) . ')');
   return $Status;
}

