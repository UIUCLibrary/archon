function ensureAdministrator($Site, $Database)
{
   global $Config;
   $Connection = sqlConnect($Database);
   if(!sqlValue($Connection, "SELECT OBJECT_ID('tblCore_Users')"))
   {
      warn("$Site: no tblCore_Users table; the test administrator was not created");
      return;
   }
   $Login = $Config['admin_login'];
   $Salt = '';
   $Characters = './0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
   for($i = 0; $i < 8; $i++)
   {
      $Salt .= $Characters[random_int(0, 63)];
   }
   // MD5-crypt, the format Archon stores (archon_password_hash() in common.inc.php).
   $Hash = crypt(readSecret('archon-admin'), '$1$' . $Salt . '$');

   $UserID = sqlValue($Connection, 'SELECT ID FROM tblCore_Users WHERE Login = ?', array($Login));
   if($UserID === NULL)
   {
      $Rows = sqlRun($Connection, "INSERT INTO tblCore_Users (Login, Email, PasswordHash, FirstName, LastName, DisplayName, IsAdminUser, RegisterTime, Pending, LanguageID, CountryID, RepositoryLimit, Locked)
         OUTPUT INSERTED.ID VALUES (?, ?, ?, 'Test', 'Administrator', 'Test Administrator', 1, ?, 0, 2081, 226, 0, 0)",
         array($Login, $Login . '@example.org', $Hash, time()));
      $UserID = $Rows[0]['ID'];
      out("$Site: created the test administrator '$Login'");
   }
   else
   {
      sqlRun($Connection, 'UPDATE tblCore_Users SET PasswordHash = ?, IsAdminUser = 1, Pending = 0, Locked = 0, RepositoryLimit = 0 WHERE ID = ?', array($Hash, $UserID));
   }

   // The sample data's staff and researcher accounts share the administrator's password.
   sqlRun($Connection, "UPDATE tblCore_Users SET PasswordHash = ? WHERE Login IN ('teststaff', 'testreader', 'testresearcher')", array($Hash));

   $GroupID = sqlValue($Connection, 'SELECT TOP 1 ID FROM tblCore_Usergroups ORDER BY DefaultPermissions DESC, ID');
   if($GroupID !== NULL && !sqlValue($Connection, 'SELECT COUNT(*) FROM tblCore_UserUsergroupIndex WHERE UserID = ? AND UsergroupID = ?', array($UserID, $GroupID)))
   {
      sqlRun($Connection, 'INSERT INTO tblCore_UserUsergroupIndex (UserID, UsergroupID) VALUES (?, ?)', array($UserID, $GroupID));
   }
   sqlsrv_close($Connection);
}

