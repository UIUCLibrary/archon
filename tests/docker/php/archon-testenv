function siteCounts($Database)
{
   $Connection = @sqlConnect($Database, true);
   if(!$Connection)
   {
      return NULL;
   }
   $Counts = array();
   $Tables = array('collections' => 'tblCollections_Collections', 'content' => 'tblCollections_Content', 'creators' => 'tblCreators_Creators',
      'subjects' => 'tblSubjects_Subjects', 'digital content' => 'tblDigitalLibrary_DigitalContent', 'accessions' => 'tblAccessions_Accessions');
   foreach($Tables as $Label => $Table)
   {
      try
      {
         $Counts[$Label] = (int)sqlValue($Connection, "SELECT COUNT(*) FROM $Table");
      }
      catch(RuntimeException $e)
      {
      }
   }
   $Settings = array();
   try
   {
      foreach(sqlRun($Connection, "SELECT Directive, CAST(Value AS nvarchar(200)) AS Value FROM tblCore_Configuration WHERE PackageID = 1 AND Directive IN ('Default Theme', 'Default Template Set')") as $Row)
      {
         $Settings[$Row['Directive']] = $Row['Value'];
      }
   }
   catch(RuntimeException $e)
   {
   }
   sqlsrv_close($Connection);
   return array('counts' => $Counts, 'settings' => $Settings);
}

