#!/bin/sh
# Copies an Archon source tree into an Apache document-root "site" and writes a
# test config.inc.php for it. Used by the Docker test environment only.
#
#   archon-sync <site> MSSQL <database-name> [source-dir]
#
# Database host/credentials come from ARCHON_TEST_* environment variables.
set -eu

if [ "$#" -lt 3 ]; then
    echo "usage: archon-sync <site> <MySQL|MSSQL> <database-name> [source-dir]" >&2
    exit 64
fi

site="$1"
server_type="$2"
database="$3"
source_dir="${4:-/src}"
dest="/var/www/html/${site}"

mkdir -p "${dest}"
# install.php and runtime caches are intentionally preserved across syncs.
rsync -a --delete \
    --exclude '.git' \
    --exclude '/tests/' \
    --exclude '/config.inc.php' \
    --exclude '/packages/core/install/install.php' \
    "${source_dir}/" "${dest}/"

case "${server_type}" in
    MSSQL)
        host="${ARCHON_TEST_MSSQL_HOST:-mssql}"
        login="${ARCHON_TEST_MSSQL_USER:-sa}"
        db_secret="${ARCHON_TEST_MSSQL_SECRET:?ARCHON_TEST_MSSQL_SECRET must be set}"
        ;;
    *)
        host="${ARCHON_TEST_MYSQL_HOST:-mysql}"
        login="${ARCHON_TEST_MYSQL_USER:-root}"
        db_secret="${ARCHON_TEST_MYSQL_SECRET:?ARCHON_TEST_MYSQL_SECRET must be set}"
        ;;
esac

php -r '
$file = $argv[1];
$values = array("ServerType" => $argv[2], "ServerAddress" => $argv[3], "Login" => $argv[4], "Password" => $argv[5], "DatabaseName" => $argv[6]);
$php = "<?php\n// Generated by archon-sync for the Docker test environment.\nrequire(\"configblank.inc.php\");\n";
foreach ($values as $key => $value) {
    $php .= "\$_ARCHON->db->" . $key . " = " . var_export($value, true) . ";\n";
}
if ($argv[2] === "MSSQL") {
    // Production settings: UTF-8 client charset; the test server uses a self-signed certificate.
    $php .= "\$_ARCHON->config->DatabaseEncodingUTF8 = true;\n";
    $php .= "\$_ARCHON->db->SqlsrvOptions = array(\"TrustServerCertificate\" => true);\n";
}
$extra = getenv("ARCHON_TEST_EXTRA_CONFIG");
if ($extra) {
    $php .= $extra . "\n";
}
file_put_contents($file, $php);
' "${dest}/config.inc.php" "${server_type}" "${host}" "${login}" "${db_secret}" "${database}"

chown -R www-data:www-data "${dest}"
echo "synced ${source_dir} -> ${dest} (${server_type}:${database})"
