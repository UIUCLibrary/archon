# Copy to .env (next to compose.yaml) to change the defaults. Every setting is optional.

# Web port and the interface it is published on (use 127.0.0.1 to keep the sites local to the host).
ARCHON_HTTP_PORT=8080
ARCHON_HTTP_BIND=0.0.0.0
# Base URL shown in the startup banner and on the index page (e.g. http://archon-test.example.edu:8080).
#ARCHON_PUBLIC_URL=

# Sites to create, one database each (archon_<site>). Known profiles: archives ihlc rbml ala.
ARCHON_SITES=archives ihlc rbml ala
# Sample data size for sites without a backup: small, standard or large.
ARCHON_SAMPLE_SIZE=standard

# Test administrator created (or reset) in every site on every start.
ARCHON_ADMIN_LOGIN=testadmin
# Leave empty to generate a password on first start (see: docker compose exec web archon-testenv credentials).
#ARCHON_ADMIN_PASSWORD=

# SQL Server. The SA password is only used when the SQL Server volume is first created; leave empty
# to generate one. MSSQL_IMAGE can pin an older SQL Server release if a backup needs it.
#MSSQL_SA_PASSWORD=
#MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_MEMORY_LIMIT_MB=2048
#MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS
